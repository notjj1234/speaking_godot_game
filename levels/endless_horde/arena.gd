class_name HordeArena
extends Node2D

## One Endless Horde battleground (levels/endless_horde/arenas/arena_0N.tscn).
## Scenes are generated by tools/arena_build/build_arenas.py from ASCII maps;
## horde_waves.gd swaps them every 20 stages (HordeCurve.arena_index_for).
##
## Children: Ground (instance of tile_maps/grass-01.tscn, LevelTileMap -> camera
## bounds), Blockers (StaticBody2D on the Walls layer, one shape per solid prop),
## SpawnPoint (Marker2D), Decor (Sprite2D props; the level moves them into its
## y-sorted DecorLayer so they sort with the player).

@export var display_name: String = "Meadow"
## Applied to Ground (and by the level to its GrassBackground) for the biome read.
@export var ground_tint: Color = Color(1, 1, 1, 1)
## Extra clearance around solid props when testing spawn positions.
@export var block_margin: float = 10.0

@onready var ground: TileMapLayer = get_node_or_null("Ground")

var _blocker_rects: Array[Rect2] = []
## Boss pathfinding grids, one per clearance (props never move, so built once).
var _grids := {}
const PATH_CELL := 16.0


func _ready() -> void:
	add_to_group("horde_arena")
	if ground:
		ground.modulate = ground_tint
	_collect_blocker_rects()


func _collect_blocker_rects() -> void:
	_blocker_rects.clear()
	var blockers := get_node_or_null("Blockers")
	if blockers == null:
		return
	for node in blockers.get_children():
		var shape_node := node as CollisionShape2D
		if shape_node == null:
			continue
		var rect_shape := shape_node.shape as RectangleShape2D
		if rect_shape == null:
			continue
		var centre := shape_node.global_position
		_blocker_rects.append(Rect2(centre - rect_shape.size * 0.5, rect_shape.size))


## True if world_pos is outside the ground, on a wall tile, or on a solid prop.
func is_blocked(world_pos: Vector2) -> bool:
	if ground == null:
		return false
	var cell := ground.local_to_map(ground.to_local(world_pos))
	if ground.get_cell_source_id(cell) == -1:
		return true
	var data := ground.get_cell_tile_data(cell)
	if data and data.get_collision_polygons_count(0) > 0:
		return true
	for rect in _blocker_rects:
		if rect.grow(block_margin).has_point(world_pos):
			return true
	return false


func spawn_point() -> Vector2:
	var marker := get_node_or_null("SpawnPoint") as Node2D
	if marker:
		return marker.global_position
	return global_position + Vector2(320, 240)


## Closest open position, searched in rings of one tile; falls back to the spawn point.
func nearest_open(world_pos: Vector2, max_rings: int = 8) -> Vector2:
	if not is_blocked(world_pos):
		return world_pos
	var step := 32.0
	if ground and ground.tile_set:
		step = float(ground.tile_set.tile_size.x)
	for ring in range(1, max_rings + 1):
		var samples := ring * 8
		for i in samples:
			var p := world_pos + Vector2.RIGHT.rotated(TAU * float(i) / float(samples)) * step * float(ring)
			if not is_blocked(p):
				return p
	return spawn_point()


## True if a circle of radius `clearance` can travel from -> to without touching
## a wall or prop (the real collision shapes on the Walls layer).
func line_clear(from: Vector2, to: Vector2, clearance: float) -> bool:
	var circle := CircleShape2D.new()
	circle.radius = clearance
	var query := PhysicsShapeQueryParameters2D.new()
	query.shape = circle
	query.collision_mask = 16
	query.transform = Transform2D(0.0, from)
	query.motion = to - from
	var hit := get_world_2d().direct_space_state.cast_motion(query)
	return hit.is_empty() or hit[0] >= 1.0


## Grid path around walls and props for a body needing `clearance` px of room.
## Empty when either end has no open cell nearby.
func boss_path(from: Vector2, to: Vector2, clearance: float) -> PackedVector2Array:
	var grid := _grid_for(clearance)
	if grid == null:
		return PackedVector2Array()
	var a := _open_cell(grid, from)
	var b := _open_cell(grid, to)
	if a.x < 0 or b.x < 0:
		return PackedVector2Array()
	return grid.get_point_path(a, b, true)


func _grid_for(clearance: float) -> AStarGrid2D:
	if _grids.has(clearance):
		return _grids[clearance]
	if ground == null or ground.tile_set == null:
		return null
	var used := ground.get_used_rect()
	var tile := Vector2(ground.tile_set.tile_size)
	var top_left := ground.to_global(ground.map_to_local(used.position) - tile * 0.5)
	var size := Vector2(used.size) * tile
	var grid := AStarGrid2D.new()
	grid.region = Rect2i(0, 0, int(size.x / PATH_CELL), int(size.y / PATH_CELL))
	grid.cell_size = Vector2(PATH_CELL, PATH_CELL)
	# Points sit on cell centres.
	grid.offset = top_left + Vector2(PATH_CELL, PATH_CELL) * 0.5
	grid.diagonal_mode = AStarGrid2D.DIAGONAL_MODE_ONLY_IF_NO_OBSTACLES
	grid.update()
	var probes := [Vector2.ZERO, Vector2(clearance, 0), Vector2(-clearance, 0), Vector2(0, clearance), Vector2(0, -clearance)]
	for x in grid.region.size.x:
		for y in grid.region.size.y:
			var centre := grid.offset + Vector2(x, y) * PATH_CELL
			for o in probes:
				if is_blocked(centre + o):
					grid.set_point_solid(Vector2i(x, y))
					break
	_grids[clearance] = grid
	return grid


## The open grid cell nearest a world position (searched in rings), or (-1, -1).
func _open_cell(grid: AStarGrid2D, world_pos: Vector2) -> Vector2i:
	var c := Vector2i(((world_pos - grid.offset) / PATH_CELL).round())
	for ring in 4:
		for dx in range(-ring, ring + 1):
			for dy in range(-ring, ring + 1):
				if maxi(absi(dx), absi(dy)) != ring:
					continue
				var p := c + Vector2i(dx, dy)
				if grid.is_in_boundsv(p) and not grid.is_point_solid(p):
					return p
	return Vector2i(-1, -1)
