class_name HordeArena
extends Node2D

## One Endless Horde battleground (levels/endless_horde/arenas/arena_0N.tscn).
## Scenes are generated by tools/arena_build/build_arenas.py from ASCII maps;
## horde_waves.gd swaps them every 20 stages (HordeCurve.arena_index_for).
##
## Children: Ground (instance of tile_maps/grass-01.tscn, LevelTileMap -> camera
## bounds), Blockers (StaticBody2D on the Walls layer, one shape per solid prop),
## SpawnPoint (Marker2D), Decor (Sprite2D props; the level moves them into its
## y-sorted DecorLayer so they sort with the player).

@export var display_name: String = "Meadow"
## Applied to Ground (and by the level to its GrassBackground) for the biome read.
@export var ground_tint: Color = Color(1, 1, 1, 1)
## Extra clearance around solid props when testing spawn positions.
@export var block_margin: float = 10.0

@onready var ground: TileMapLayer = get_node_or_null("Ground")

var _blocker_rects: Array[Rect2] = []


func _ready() -> void:
	if ground:
		ground.modulate = ground_tint
	_collect_blocker_rects()


func _collect_blocker_rects() -> void:
	_blocker_rects.clear()
	var blockers := get_node_or_null("Blockers")
	if blockers == null:
		return
	for node in blockers.get_children():
		var shape_node := node as CollisionShape2D
		if shape_node == null:
			continue
		var rect_shape := shape_node.shape as RectangleShape2D
		if rect_shape == null:
			continue
		var centre := shape_node.global_position
		_blocker_rects.append(Rect2(centre - rect_shape.size * 0.5, rect_shape.size))


## True if world_pos is outside the ground, on a wall tile, or on a solid prop.
func is_blocked(world_pos: Vector2) -> bool:
	if ground == null:
		return false
	var cell := ground.local_to_map(ground.to_local(world_pos))
	if ground.get_cell_source_id(cell) == -1:
		return true
	var data := ground.get_cell_tile_data(cell)
	if data and data.get_collision_polygons_count(0) > 0:
		return true
	for rect in _blocker_rects:
		if rect.grow(block_margin).has_point(world_pos):
			return true
	return false


func spawn_point() -> Vector2:
	var marker := get_node_or_null("SpawnPoint") as Node2D
	if marker:
		return marker.global_position
	return global_position + Vector2(320, 240)


## Closest open position, searched in rings of one tile; falls back to the spawn point.
func nearest_open(world_pos: Vector2, max_rings: int = 8) -> Vector2:
	if not is_blocked(world_pos):
		return world_pos
	var step := 32.0
	if ground and ground.tile_set:
		step = float(ground.tile_set.tile_size.x)
	for ring in range(1, max_rings + 1):
		var samples := ring * 8
		for i in samples:
			var p := world_pos + Vector2.RIGHT.rotated(TAU * float(i) / float(samples)) * step * float(ring)
			if not is_blocked(p):
				return p
	return spawn_point()
