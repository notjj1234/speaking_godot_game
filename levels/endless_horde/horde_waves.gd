extends Level

const SPAWN_RADIUS := 96.0
const MIN_SPACING := 48.0
const BOUNDS_INSET := 64.0
const MIN_PLAYER_DISTANCE := 48.0
const PICKUP_PULL_SPEED := 280.0
const PICKUP_COLLECT_DISTANCE := 18.0
const WALLS_LAYER := 16
const STAGE_CLEAR_PAUSE := 0.6
## Beating a block's boss rests you at the camp, as a victory (not a death).
const CAMP_PATH := "res://levels/endless_horde/camp/camp.tscn"
## MusicManager tracks: one per arena (HordeCurve.ARENA_NAMES order), one per boss kind.
const ARENA_MUSIC: Array[StringName] = [&"meadow", &"ruins", &"ashen", &"frozen"]
const BOSS_MUSIC := {"slime": &"boss_slime", "skeleton": &"boss_bone", "orc": &"boss_orc", "bandit": &"boss_frost"}
const CAMP_RETRY_DELAY := 0.25

const NORMAL_HP := 6

const SLIME := preload("res://enemies/slime/slime.tscn")
const GOBLIN := preload("res://enemies/goblin/goblin.tscn")
const BEETLE := preload("res://enemies/beetle/beetle.tscn")
const ORC := preload("res://enemies/orc/orc.tscn")
const SKELETON := preload("res://enemies/skeleton/skeleton.tscn")
const BANDIT := preload("res://enemies/bandit/bandit.tscn")
const START_FONT := preload("res://gui/fonts/Abaddon Bold.ttf")
## One scene per HordeCurve.arena_index_for() value (generated by tools/arena_build).
const ARENAS: Array[PackedScene] = [
	preload("res://levels/endless_horde/arenas/arena_01.tscn"),
	preload("res://levels/endless_horde/arenas/arena_02.tscn"),
	preload("res://levels/endless_horde/arenas/arena_03.tscn"),
	preload("res://levels/endless_horde/arenas/arena_04.tscn"),
]
const SPAWN_TRIES := 16
## A new enemy never appears closer than this to the player (hugging a wall used
## to squeeze ring positions back inside the arena, right on top of you).
const SAFE_SPAWN_GAP := 72.0
## WaveLabel rows: normal, and pushed below the HUD's mic banner when it shows.
const LABEL_TOP := 56.0
const LABEL_TOP_UNDER_BANNER := 84.0
## The wave label and mic banner fade to this while the player or a boss is
## under them, so the top wall is never a blind spot.
const HUD_FADE_ALPHA := 0.35
const HUD_FADE_SPEED := 6.0

var _stage := 0
var _spawn_quota := 0
var _spawned_count := 0
var _spawn_accum := 0.0
var _stage_active := false
var _clear_pause := 0.0
## Set when a boss stage is cleared: the clear pause ends in the camp, not the next stage.
var _boss_exit := false
var _leaving := false
var _practice := true
var _start_pad: Node2D
## Arrow toward the start pad while practising.
var _pad_pointer: GuidePointer
var _pad_restore: Array[Dictionary] = []
var _idle_accum := 0.0
var _arena: HordeArena
var _arena_index := -1
## Everything below reads the arena ground through _grass; _apply_arena re-points it.
var _grass: TileMapLayer

@onready var _enemies: Node2D = $HordeEnemies
@onready var _label: Label = $WaveLayer/WaveLabel
@onready var _decor_layer: Node2D = $DecorLayer
@onready var _start_timer: Timer = $StartTimer


func _ready() -> void:
	super()
	PlayerManager.revive_for_horde()
	# Anything that lands inside a wall or solid prop (beetle split-offs, knock-ins)
	# is moved to the nearest open spot.
	_enemies.child_entered_tree.connect(_on_horde_child_added)
	var resume := 0
	var tracker := get_node_or_null("/root/ProgressTracker")
	if tracker and tracker.has_method("horde_resume_stage"):
		resume = int(tracker.horde_resume_stage())
	# Load the right arena before anything spawns: resuming at stage 47 goes straight
	# to arena 2; practice (resume 0) uses arena 0. Also adds the TopBarrier.
	await _apply_arena(resume)
	_play_music(resume)
	var direct := TrainingState.consume_direct_start()
	if resume > 0:
		_practice = false
		_begin_stage(resume)
	elif direct:
		# Straight from Training (camp tour or Skip tutorial): no practice pad.
		_practice = false
		if tracker and tracker.has_method("record_run_started"):
			tracker.record_run_started()
		_begin_stage(1)
	else:
		_set_word_tracker_stage(0)
		_label.text = "Practice"
		_spawn_practice_dummy()
		_spawn_start_pad()


func _free_level() -> void:
	_set_word_tracker_stage(0)
	PlayerManager.set_health(NORMAL_HP, NORMAL_HP)
	super()


func _process(delta: float) -> void:
	_place_wave_label()
	_fade_top_hud(delta)
	if get_tree().paused:
		return
	if _speech_challenge_active():
		return
	if _practice:
		return

	_apply_idle_dps(delta)

	if _clear_pause > 0.0:
		_clear_pause -= delta
		if _clear_pause <= 0.0:
			if _boss_exit:
				_go_to_camp()
			else:
				_begin_stage(_stage + 1)
		return

	if not _stage_active:
		return

	# Trickle-spawn remaining quota while under the alive cap.
	if _spawned_count < _spawn_quota:
		_spawn_accum += delta
		var interval := HordeCurve.spawn_interval(_stage)
		while _spawned_count < _spawn_quota and _spawn_accum >= interval:
			if _enemy_count() >= _alive_cap():
				break
			_spawn_accum -= interval
			_spawn_one_enemy(_spawned_count)
			_spawned_count += 1

	# Stage clear: all spawned, none alive, pickups collected.
	if _spawned_count < _spawn_quota:
		return
	if _enemy_count() > 0:
		return
	var pickups := _pickups()
	if not pickups.is_empty():
		_pull_pickups(pickups, delta)
		return

	_on_stage_cleared()


func _apply_idle_dps(_delta: float) -> void:
	# Phase 5 stub: HordeCurve.idle_dps_per_sec() is 0 in v1.
	var dps := HordeCurve.idle_dps_per_sec()
	if dps <= 0.0:
		return
	_idle_accum += _delta
	if _idle_accum < 1.0:
		return
	_idle_accum -= 1.0
	# Future: apply floor(dps) via Enemy._take_damage to nearest living horde enemy.


func _unhandled_input(event: InputEvent) -> void:
	if get_tree().paused or get_tree().current_scene != self:
		return
	if not event is InputEventKey or not event.pressed or event.echo:
		return
	var key_event := event as InputEventKey
	var target := _dev_stage_target(key_event)
	if target < 1:
		return
	_jump_to_stage(target)
	get_viewport().set_input_as_handled()


func _dev_stage_target(event: InputEventKey) -> int:
	var keycode := event.keycode if event.keycode != 0 else event.physical_keycode
	if keycode == KEY_BRACKETRIGHT:
		return maxi(_stage, 0) + 1
	if keycode == KEY_BRACKETLEFT:
		return maxi(_stage - 1, 1)
	if not event.shift_pressed:
		return -1
	match keycode:
		KEY_1:
			return 1
		KEY_2:
			return 2
		KEY_3:
			return 3
		KEY_4:
			return 4
		KEY_5:
			return 5
		KEY_6:
			return 6
		KEY_7:
			return 7
		KEY_8:
			return 8
		KEY_9:
			return 9
		KEY_0:
			return 10
	return -1


func _jump_to_stage(target: int) -> void:
	_end_practice()
	if _start_timer:
		_start_timer.stop()
	_clear_horde()
	_clear_pause = 0.0
	_boss_exit = false
	_spawn_accum = 0.0
	print("✅ Dev skip to horde stage ", target)
	_begin_stage(target)


func _spawn_practice_dummy() -> void:
	var enemy: Enemy = SLIME.instantiate()
	_enemies.add_child(enemy)
	enemy.global_position = _open_position(_clamp_to_grass(_player_position() + Vector2(72, 0)))
	enemy.reset_physics_interpolation()
	enemy.make_practice_dummy()


func _spawn_start_pad() -> void:
	var pad_pos := _clamp_to_grass(_grass_center() + Vector2(0, 104))
	if pad_pos.distance_to(_player_position()) < 96.0:
		pad_pos = _clamp_to_grass(_player_position() + Vector2(0, 120))
	var center := _paint_start_path(pad_pos)
	var root := Node2D.new()
	root.name = "StartPad"
	root.z_index = 3
	var label := Label.new()
	label.text = "Walk here to start!"
	label.position = Vector2(-64, 36)  # under the square; the arrow is above it
	label.size = Vector2(128, 18)
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	label.add_theme_font_override("font", START_FONT)
	label.add_theme_font_size_override("font_size", 12)
	label.add_theme_color_override("font_color", Color(1, 1, 1, 1))
	label.add_theme_color_override("font_outline_color", Color(0, 0, 0, 1))
	label.add_theme_constant_override("outline_size", 4)
	label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	root.add_child(label)
	var area := Area2D.new()
	area.collision_layer = 0
	area.collision_mask = 1
	area.monitoring = true
	var shape_node := CollisionShape2D.new()
	var shape := RectangleShape2D.new()
	shape.size = Vector2(64, 64)
	shape_node.shape = shape
	area.add_child(shape_node)
	area.body_entered.connect(_on_start_pad_body)
	root.add_child(area)
	add_child(root)
	root.global_position = center
	HordeArenaHelpers.add_glow(root, center, Vector2(64, 64))
	_start_pad = root
	_pad_pointer = GuidePointer.new()
	add_child(_pad_pointer)
	_pad_pointer.follow(func(): return _start_pad if is_instance_valid(_start_pad) else null)
	CoachTips.show_once(self, "practice_pad", CoachTips.PRACTICE_PAD)


func _paint_start_path(around: Vector2) -> Vector2:
	return HordeArenaHelpers.paint_patch(_grass, around, _pad_restore)


func _on_start_pad_body(body: Node) -> void:
	if not _practice or body != PlayerManager.player:
		return
	_end_practice()
	_clear_horde()
	PlayerManager.set_player_position(_arena.spawn_point() if _arena else _grass_center())
	_clear_pause = 0.0
	_spawn_accum = 0.0
	var tracker := get_node_or_null("/root/ProgressTracker")
	if tracker and tracker.has_method("record_run_started"):
		tracker.record_run_started()
	_begin_stage(1)


func _end_practice() -> void:
	_practice = false
	if _start_pad and is_instance_valid(_start_pad):
		_start_pad.queue_free()
	_start_pad = null
	if _pad_pointer and is_instance_valid(_pad_pointer):
		_pad_pointer.queue_free()
	_pad_pointer = null
	_restore_start_path()


func _restore_start_path() -> void:
	HordeArenaHelpers.restore_patch(_grass, _pad_restore)


func _grass_center() -> Vector2:
	if _grass == null:
		return global_position
	var rect := _grass.get_used_rect()
	if rect.size == Vector2i.ZERO:
		return global_position
	var min_cell := rect.position
	var max_cell := rect.position + rect.size - Vector2i.ONE
	var min_pos := _grass.to_global(_grass.map_to_local(min_cell))
	var max_pos := _grass.to_global(_grass.map_to_local(max_cell))
	return (min_pos + max_pos) * 0.5


func _clear_horde() -> void:
	for child in _enemies.get_children():
		if is_instance_valid(child):
			child.queue_free()


func _begin_stage(stage: int) -> void:
	# Arena first (no-op unless this stage starts a new 20-stage block). Never mid-stage.
	_stage_active = false
	var arena_before := _arena_index
	await _apply_arena(stage)
	_stage = maxi(stage, 1)
	if HordeCurve.is_boss_stage(_stage):
		CoachTips.show_once(self, "first_boss", CoachTips.FIRST_BOSS)
	elif _arena_index > 0 and _arena_index != arena_before:
		CoachTips.show_once(self, "new_arena", CoachTips.NEW_ARENA)
	var short_retry := false
	var tracker := get_node_or_null("/root/ProgressTracker")
	if tracker \
			and tracker.has_method("horde_short_retry") \
			and tracker.has_method("horde_stuck_stage") \
			and bool(tracker.horde_short_retry()) \
			and int(tracker.horde_stuck_stage()) == _stage:
		short_retry = true
	_spawn_quota = HordeCurve.retry_quota(_stage, short_retry)
	_spawned_count = 0
	_spawn_accum = HordeCurve.spawn_interval(_stage) # first enemy promptly
	_stage_active = true
	_clear_pause = 0.0
	_boss_exit = false
	_set_word_tracker_stage(_stage)
	_label.text = _stage_label(_stage)
	_play_music(_stage)
	print("✅ Starting horde stage ", _stage, " (quota ", _spawn_quota, ", short=", short_retry, ")")
	if tracker and tracker.has_method("record_stage_reached"):
		tracker.record_stage_reached(_stage)


func _on_stage_cleared() -> void:
	_stage_active = false
	_label.text = "Stage clear"
	print("✅ Stage ", _stage, " cleared")
	var tracker := get_node_or_null("/root/ProgressTracker")
	if tracker and tracker.has_method("record_stage_cleared"):
		tracker.record_stage_cleared(_stage)
	if HordeCurve.is_boss_stage(_stage):
		# Victory: never the death route (no show_defeat / record_horde_death).
		if tracker and tracker.has_method("record_boss_cleared"):
			tracker.record_boss_cleared(_stage)
		_label.text = "Boss defeated!"
		_boss_exit = true
		_play_music(-1)  # the victory sting plays over silence; the camp has its own track
		var sfx := get_node_or_null("/root/Sfx")
		if sfx:
			sfx.play(&"victory")
		print("✅ Boss stage ", _stage, " cleared, resting at the camp")
	if tracker and tracker.has_method("request_flush"):
		tracker.request_flush()
	_clear_pause = HordeCurve.BOSS_CLEAR_PAUSE if _boss_exit else STAGE_CLEAR_PAUSE


func _go_to_camp() -> void:
	if _leaving:
		return
	if LevelManager.is_loading:
		# Another load owns the transition; re-arm so _process tries again after it.
		_clear_pause = CAMP_RETRY_DELAY
		return
	if not ResourceLoader.exists(CAMP_PATH):
		print("⚠️ Horde: camp scene missing, continuing to the next stage")
		_boss_exit = false
		_begin_stage(_stage + 1)
		return
	_leaving = true
	PlayerManager.player_spawned = false
	LevelManager.load_new_level(CAMP_PATH, "", Vector2.ZERO)


func _spawn_one_enemy(index: int) -> void:
	var kind := HordeCurve.kind_for(_stage, index)
	var scene := _scene_for_kind(kind)
	var enemy: Enemy = scene.instantiate() as Enemy
	if enemy == null:
		return

	# Apply HP / split before add_child so _ready copies max_hp correctly.
	var base_hp := enemy.hp
	var easing := _first_run_ease()
	var mult := HordeCurve.hp_multiplier(_stage) * easing
	enemy.hp = maxi(1, roundi(float(base_hp) * mult))

	# Scale outgoing damage (body contact + goblin's nested AttackHurtBox).
	var damage_mult := HordeCurve.damage_multiplier(_stage) * easing
	for hb: HurtBox in enemy.find_children("*", "HurtBox"):
		hb.damage = maxi(1, roundi(float(hb.damage) * damage_mult))

	var splits := HordeCurve.split_count_for(_stage)
	if kind == "beetle":
		if splits <= 0:
			enemy.splits_on_destroy = false
			enemy.split_count = 0
		else:
			enemy.splits_on_destroy = true
			enemy.split_count = splits
			enemy.split_hp = maxi(1, roundi(float(enemy.split_hp) * mult))
	else:
		enemy.splits_on_destroy = false

	var boss := HordeCurve.boss_for_stage(_stage)
	if not boss.is_empty():
		enemy.make_boss(boss, HordeCurve.boss_phase_hp(_stage))
		for hb: HurtBox in enemy.find_children("*", "HurtBox"):
			hb.damage = mini(hb.damage, HordeCurve.BOSS_MAX_HIT)

	var origin := _player_position()
	var count := _spawn_quota
	var radius := _ring_radius(count)
	var angle := TAU * float(index) / float(maxi(count, 1))
	var pos := _pick_spawn_position(origin, angle, radius)
	if enemy.is_boss():
		pos = _boss_spawn_position(origin)

	_enemies.add_child(enemy)
	enemy.global_position = pos
	enemy.reset_physics_interpolation()
	_apply_speed_multiplier(enemy, HordeCurve.speed_multiplier(_stage) * easing)
	if enemy.is_boss():
		enemy.boss_phase_changed.connect(_on_boss_phase_changed.bind(enemy))


## First-run easing (HordeCurve.first_run_ease) for the current stage.
func _first_run_ease() -> float:
	return HordeCurve.first_run_ease(_stage, _lifetime_runs())


func _lifetime_runs() -> int:
	var tracker := get_node_or_null("/root/ProgressTracker")
	if tracker == null or not tracker.has_method("lifetime"):
		return 0
	return int(tracker.lifetime().get("runs", 0))


## One fewer enemy on screen while the first run is still eased.
func _alive_cap() -> int:
	var cap := HordeCurve.alive_cap(_stage)
	return cap - 1 if _first_run_ease() < 1.0 else cap


func _on_boss_phase_changed(phase: int, phases: int, boss: Enemy) -> void:
	_label.text = "%s %d/%d" % [boss.boss_name, phase, phases]
	var music := get_node_or_null("/root/MusicManager")
	if music:
		music.set_intensity(phase)


## The horde picks its track per stage (_music_for), not per level.
func music_track() -> StringName:
	return &""


## Boss stages play the boss's theme, other stages their arena's; -1 is silence.
func _music_for(stage: int) -> StringName:
	if stage < 0:
		return &""
	if HordeCurve.is_boss_stage(stage):
		return BOSS_MUSIC.get(str(HordeCurve.boss_for_stage(stage).get("kind", "")), &"")
	return ARENA_MUSIC[HordeCurve.arena_index_for(stage) % ARENA_MUSIC.size()]


func _play_music(stage: int) -> void:
	var music := get_node_or_null("/root/MusicManager")
	if music:
		music.play_track(_music_for(stage))


func _apply_speed_multiplier(enemy: Enemy, mult: float) -> void:
	var wander := enemy.get_node_or_null("EnemyStateMachine/Wander")
	if wander and wander.get("wander_speed") != null:
		wander.set("wander_speed", float(wander.get("wander_speed")) * mult)
	var chase := enemy.get_node_or_null("EnemyStateMachine/Chase")
	# The orc walks at stalk_speed (its chase_speed is unused), so scale both.
	for prop in ["chase_speed", "stalk_speed"]:
		if chase and chase.get(prop) != null:
			chase.set(prop, float(chase.get(prop)) * mult)


## Bosses enter from the far side: the roomy open spot farthest from the
## player, out of the top HUD band, so the fight never opens with a hit.
func _boss_spawn_position(origin: Vector2) -> Vector2:
	var best := _pick_spawn_position(origin, 0.0, HordeCurve.BOSS_SPAWN_MIN_GAP)
	var best_dist := -1.0
	for ring in range(0, 5):
		var radius := HordeCurve.BOSS_SPAWN_MIN_GAP + 40.0 * float(ring)
		for i in 24:
			var p := _clamp_to_grass(origin + Vector2.RIGHT.rotated(TAU * float(i) / 24.0) * radius)
			if p.y < HordeCurve.BOSS_SPAWN_TOP_BAND or not _roomy_for_boss(p):
				continue
			var d := p.distance_to(origin)
			if d > best_dist:
				best_dist = d
				best = p
	return best


func _roomy_for_boss(p: Vector2) -> bool:
	if _arena == null:
		return true
	for o in [Vector2.ZERO, Vector2(24, 0), Vector2(-24, 0), Vector2(0, 12), Vector2(0, -12)]:
		if _arena.is_blocked(p + o):
			return false
	return true


func _scene_for_kind(kind: String) -> PackedScene:
	match kind:
		"goblin":
			return GOBLIN
		"beetle":
			return BEETLE
		"orc":
			return ORC
		"skeleton":
			return SKELETON
		"bandit":
			return BANDIT
		_:
			return SLIME


## Walk round the ring from `angle`: first spot that is open and at least
## SAFE_SPAWN_GAP from the player wins; otherwise the farthest open spot tried.
func _pick_spawn_position(origin: Vector2, angle: float, radius: float) -> Vector2:
	var best := Vector2.ZERO
	var best_dist := -1.0
	for i in SPAWN_TRIES + 1:
		var candidate := _ring_position(origin, angle + TAU * float(i) / float(SPAWN_TRIES), radius)
		if _arena and _arena.is_blocked(candidate):
			continue
		var dist := candidate.distance_to(origin)
		if dist >= SAFE_SPAWN_GAP:
			return candidate
		if dist > best_dist:
			best = candidate
			best_dist = dist
	if best_dist >= 0.0:
		return best
	return _open_position(_ring_position(origin, angle, radius))


func _on_horde_child_added(node: Node) -> void:
	if node is Enemy:
		# Deferred: spawners set the position right after add_child.
		call_deferred("_unstick_enemy", node)


func _unstick_enemy(node: Node) -> void:
	var enemy := node as Node2D
	if enemy == null or not is_instance_valid(enemy) or enemy.is_queued_for_deletion():
		return
	if _arena and _arena.is_blocked(enemy.global_position):
		enemy.global_position = _arena.nearest_open(enemy.global_position)
		enemy.reset_physics_interpolation()


func _exit_tree() -> void:
	# The banner lives in the PlayerHud autoload: never leave it faded.
	var banner := _hud_banner()
	if banner:
		banner.modulate.a = 1.0


func _hud_banner() -> CanvasItem:
	var hud := get_node_or_null("/root/PlayerHud")
	return hud.get("voice_only_banner") as CanvasItem if hud else null


func _fade_top_hud(delta: float) -> void:
	var banner := _hud_banner()
	var covers: Array[Rect2] = [_label.get_global_rect()]
	if banner and banner.visible and banner is Control:
		covers.append((banner as Control).get_global_rect())
	var under := _under_hud(PlayerManager.player, covers)
	for child in _enemies.get_children():
		if not under and child is Enemy and (child as Enemy).is_boss():
			under = _under_hud(child, covers)
	var a := move_toward(_label.modulate.a, HUD_FADE_ALPHA if under else 1.0, HUD_FADE_SPEED * delta)
	_label.modulate.a = a
	if banner:
		banner.modulate.a = a


## Whether a body's on-screen sprite box overlaps any of the HUD rects.
## Untyped `body`: a typed Node2D argument errors on a freed object before the
## validity check can run.
func _under_hud(body, covers: Array[Rect2]) -> bool:
	if body == null or not is_instance_valid(body) or not (body is Node2D) or not body.is_inside_tree():
		return false
	var s := absf(body.global_scale.x)
	var world := Rect2(body.global_position + Vector2(-12.0, -30.0) * s, Vector2(24.0, 30.0) * s)
	var screen := get_viewport().get_canvas_transform() * world
	for r in covers:
		if r.intersects(screen):
			return true
	return false


func _place_wave_label() -> void:
	var hud := get_node_or_null("/root/PlayerHud")
	var banner = hud.get("voice_only_banner") if hud else null
	var under := banner is CanvasItem and (banner as CanvasItem).visible
	var top := LABEL_TOP_UNDER_BANNER if under else LABEL_TOP
	if not is_equal_approx(_label.offset_top, top):
		_label.offset_top = top
		_label.offset_bottom = top + 28.0


func _ring_position(origin: Vector2, angle: float, radius: float) -> Vector2:
	var pos := origin + Vector2.RIGHT.rotated(angle) * radius
	if pos.distance_to(origin) < MIN_PLAYER_DISTANCE:
		pos = origin + Vector2.RIGHT.rotated(angle) * MIN_PLAYER_DISTANCE
	return _clamp_to_grass(pos)


func _open_position(pos: Vector2) -> Vector2:
	if _arena and _arena.is_blocked(pos):
		return _arena.nearest_open(pos)
	return pos


func _ring_radius(count: int) -> float:
	var needed := (float(count) * MIN_SPACING) / TAU
	return maxf(SPAWN_RADIUS, needed)


func _player_position() -> Vector2:
	if PlayerManager.player:
		return PlayerManager.player.global_position
	return global_position


func _enemy_count() -> int:
	var alive := 0
	for child in _enemies.get_children():
		if not is_instance_valid(child) or child.is_queued_for_deletion():
			continue
		if child is ItemPickup:
			continue
		alive += 1
	return alive


func _pickups() -> Array[ItemPickup]:
	var found: Array[ItemPickup] = []
	for child in _enemies.get_children():
		if child is ItemPickup and is_instance_valid(child) and not child.is_queued_for_deletion():
			found.append(child)
	return found


func _pull_pickups(pickups: Array[ItemPickup], delta: float) -> void:
	var player := PlayerManager.player
	if player == null:
		return
	var dest := player.global_position
	for drop in pickups:
		if drop.has_meta("horde_collecting"):
			continue
		drop.velocity = Vector2.ZERO
		# Pulled every drawn frame, not on the physics tick: draw it as-is.
		drop.physics_interpolation_mode = Node.PHYSICS_INTERPOLATION_MODE_OFF
		drop.global_position = drop.global_position.move_toward(dest, PICKUP_PULL_SPEED * delta)
		if drop.global_position.distance_to(dest) <= PICKUP_COLLECT_DISTANCE:
			_collect_pickup(drop)


func _collect_pickup(drop: ItemPickup) -> void:
	if drop.has_meta("horde_collecting"):
		return
	drop.set_meta("horde_collecting", true)
	var accepted := false
	if drop.item_data and PlayerManager.INVENTORY_DATA:
		accepted = PlayerManager.INVENTORY_DATA.add_item(drop.item_data)
	if accepted:
		drop.item_picked_up()
	else:
		drop.queue_free()


## Load the arena for this stage (HordeCurve.arena_index_for). Returns at once when
## that arena is already loaded, so calling it from every _begin_stage is cheap.
func _apply_arena(stage: int) -> void:
	var index := HordeCurve.arena_index_for(stage)
	# 1. already there
	if _arena != null and is_instance_valid(_arena) and _arena_index == index:
		return
	# 2. drop the old arena, its top barrier and its decor
	if _arena != null and is_instance_valid(_arena):
		remove_child(_arena)
		_arena.queue_free()
	_arena = null
	_grass = null
	_pad_restore.clear()
	var old_barrier := get_node_or_null("TopBarrier")
	if old_barrier:
		remove_child(old_barrier)
		old_barrier.queue_free()
	for old_decor in _decor_layer.get_children():
		_decor_layer.remove_child(old_decor)
		old_decor.queue_free()
	# 3. instance the new one; wait a frame so LevelTileMap._ready() has
	#    republished the camera bounds
	var arena := ARENAS[index].instantiate() as HordeArena
	arena.name = "Arena"
	add_child(arena)
	move_child(arena, 1)
	await get_tree().process_frame
	# 4. everything else in this script reads the ground through _grass
	_arena = arena
	_arena_index = index
	_grass = arena.ground
	# 5. decor sorts with the player: move it into the level-owned, y-sorted DecorLayer
	var decor := arena.get_node_or_null("Decor")
	if decor:
		for sprite in decor.get_children():
			sprite.reparent(_decor_layer)
	var backdrop := get_node_or_null("GrassBackground") as CanvasItem
	if backdrop:
		backdrop.modulate = arena.ground_tint
	# 6. fresh barrier, no leftovers
	_add_top_barrier()
	_clear_horde()
	# 7. player on the arena's spawn point; first enemy comes promptly
	PlayerManager.set_player_position(arena.spawn_point())
	_spawn_accum = HordeCurve.spawn_interval(maxi(stage, 1))
	# 8. label
	if not _practice or stage > 0:
		_label.text = _stage_label(maxi(stage, 1))
	print("✅ Horde arena ", index + 1, " (", arena.display_name, ") loaded for stage ", stage)


func _stage_label(stage: int) -> String:
	# Plain hyphen: the wave font (Abaddon Bold) has no middle-dot glyph and the
	# web build has no system font to fall back on.
	if HordeCurve.is_boss_stage(stage):
		return "Stage %d - %s" % [stage, str(HordeCurve.boss_for_stage(stage).get("name", "Boss"))]
	var arena_name := _arena.display_name if _arena else HordeCurve.arena_name_for(HordeCurve.arena_index_for(stage))
	return "Stage %d - %s" % [stage, arena_name]


func _add_top_barrier() -> void:
	HordeArenaHelpers.add_top_barrier(self, _grass, WALLS_LAYER)


func _clamp_to_grass(pos: Vector2) -> Vector2:
	return HordeArenaHelpers.clamp_to_grass(_grass, pos, BOUNDS_INSET)


func _speech_challenge_active() -> bool:
	var word_tracker = get_node_or_null("/root/WordTracker")
	return word_tracker != null and bool(word_tracker.speech_challenge_active)


func _set_word_tracker_stage(stage: int) -> void:
	var word_tracker = get_node_or_null("/root/WordTracker")
	if word_tracker:
		word_tracker.horde_stage = stage
