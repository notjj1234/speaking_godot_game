# Godot 4+ specific ignores
.godot/

# Godot-specific ignores
.import/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Ignore Godot Android library files
android/build/libs/godot-lib.template_debug.aar
*.aar
!addons/speech_to_text_android/bin/*.aar
ios/plugins/loqui_speech/build/
addons/speech_to_text_android/android/.gradle/
addons/speech_to_text_android/android/**/build/
addons/speech_to_text_android/android/local.properties

android/build/
# Generated by build/serve_https.py for phone testing (SANs follow your LAN IP).
build/phone-certs/

# Build outputs: regenerated locally, too large for git (GitHub rejects >100 MB).
build/android/
build/macos/
build/windows/

