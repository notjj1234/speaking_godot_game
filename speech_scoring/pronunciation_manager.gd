# pronunciation_manager.gd
#
# Autoload manager for pronunciation scoring. Selects the scoring backend the
# same way STTManager selects STT providers (speech_to_text/STTManager.gd), and
# resolves canonical phoneme strings for challenge texts.
#
# NOTE: no class_name — the autoload is already named PronunciationManager
# (same pattern as SettingsManager in 00_globals/global_settings.gd).

extends Node

var scorer: PronunciationScorer = null


func _ready() -> void:
	scorer = _create_scorer()
	print("✅ PronunciationManager ready. Scorer: ", scorer.get_class() if scorer else "null")


func _create_scorer() -> PronunciationScorer:
	if OS.has_feature("web"):
		var web_scorer := WebPronunciationScorer.new()
		web_scorer.name = "WebPronunciationScorer"
		add_child(web_scorer)
		return web_scorer
	var unavailable := UnavailablePronunciationScorer.new()
	unavailable.name = "UnavailablePronunciationScorer"
	add_child(unavailable)
	return unavailable


func get_scorer() -> PronunciationScorer:
	return scorer


func phonemes_for(text: String) -> String:
	# Loads canonical phoneme tokens from sentence_data/phonemes.json (generated by
	# tools/gen_phonemes.py from the game's word/sentence lists). Returns "" when no
	# phoneme data exists (caller must fall back to transcript acceptance).
	var path := "res://sentence_data/phonemes.json"
	if not FileAccess.file_exists(path):
		return ""
	var file := FileAccess.open(path, FileAccess.READ)
	if file == null:
		return ""
	var data = JSON.parse_string(file.get_as_text())
	file.close()
	if data == null or not data is Dictionary:
		return ""
	var key: String = text.to_lower().strip_edges()
	if key.is_empty():
		return ""
	if data.has(key):
		return String(data[key])
	return ""
